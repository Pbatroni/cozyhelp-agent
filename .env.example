# Copy this file to .env and fill in real values. Never commit .env.
# Use ONE of these. If ANTHROPIC_API_KEY is set, CozyHelp uses Claude.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
# Staff app logins, as name:password pairs separated by commas. Use long passwords.
STAFF_ACCOUNTS=yourname:a-long-password
